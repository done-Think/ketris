{
  "name": "ketris",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ketris/web",
    "build": "npm run build -w @ketris/web",
    "start": "npm run start -w @ketris/web",
    "lint": "npm run lint -w @ketris/web",
    "lint:fix": "npm run lint:fix -w @ketris/web",
    "format": "npm run format -w @ketris/web",
    "format:check": "npm run format:check -w @ketris/web",
    "typecheck": "npm run typecheck -w @ketris/web",
    "test": "npm run test -w @ketris/web",
    "test:run": "npm run test:run -w @ketris/web",
    "test:coverage": "npm run test:coverage -w @ketris/web",
    "e2e": "npm run e2e -w @ketris/web",
    "e2e:open": "npm run e2e:open -w @ketris/web",
    "db:generate": "npm run db:generate -w @ketris/web",
    "db:migrate": "npm run db:migrate -w @ketris/web",
    "db:deploy": "npm run db:deploy -w @ketris/web",
    "db:studio": "npm run db:studio -w @ketris/web",
    "db:seed": "npm run db:seed -w @ketris/web",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@mui/private-theming": "6.4.9",
    "@mui/styled-engine": "6.5.0",
    "@mui/system": "6.5.0",
    "@mui/types": "7.2.21",
    "@mui/utils": "6.4.9",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.1",
    "next": "16.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "eslint --config apps/web/eslint.config.mjs --fix",
      "prettier --config apps/web/.prettierrc --write"
    ],
    "apps/web/**/*.{json,md,css}": [
      "prettier --config apps/web/.prettierrc --write"
    ]
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "@sentry/cli@2.58.6": true,
    "cypress@13.17.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.15.47": true
  }
}
