# Exemplo sem credenciais: copie somente as entradas necessárias para seu
# ambiente privado. Nunca comite os valores preenchidos.
FACE_CHECK_DATA_ENCRYPTION_KEY=
FACE_CHECK_ENGINE_URL=http://127.0.0.1:8765
FACE_CHECK_ENGINE_TOKEN=
FACE_CHECK_S3_BUCKET_NAME=
FACE_CHECK_RETENTION_SECRET=

# Somente desenvolvimento; não habilita fallback em NODE_ENV=production.
FACE_CHECK_LOCAL_STORAGE=true
