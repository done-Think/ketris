# Copie para terraform.tfvars (já git-ignorado) e preencha os valores reais.
# NUNCA commite terraform.tfvars — só este .example, sem segredo nenhum dentro.

aws_region  = "us-east-1"
db_username = "ketris"

# Opcional: snapshots automáticos do GitHub Actions via OIDC.
# Se a role foi criada no console, importe-a antes do apply (ver README).
github_release_enabled   = false
github_oidc_provider_arn = ""

# Preencha com as origens reais da aplicação (sem caminho, barra final ou curinga).
# Sem esta configuração, o upload direto de PDFs de Contracts não estará habilitado no navegador.
contract_document_allowed_origins = ["https://preview.seu-dominio.example"]

# db_password: NÃO defina aqui. Use uma das duas opções:
#   1) export TF_VAR_db_password="sua-senha-forte-aqui"   (antes de rodar terraform)
#   2) gere e cole em terraform.tfvars (arquivo git-ignorado), nunca neste .example
