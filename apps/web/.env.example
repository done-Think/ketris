# App
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco de dados (Postgres local — ver docker-compose.yml na raiz: `docker compose up -d`)
DATABASE_URL="postgresql://ketris:ketris@localhost:55432/ketris?schema=public"

# API/BFF: vazio/relativo aponta para o próprio Next.js (Route Handlers em src/app/api, ver ADR-0001,
# docs/adr/0001-bff-banco-orm.md). Só use uma URL absoluta se o BFF for extraído para um serviço separado.
NEXT_PUBLIC_API_URL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=troque-por-um-secret-forte

# Access token (JWT, jose/HS256) assinado pelo BFF — deliberadamente separado do NEXTAUTH_SECRET
# (ver docs/adr/0002-arquitetura-interna-bff.md)
AUTH_TOKEN_SECRET=troque-por-outro-secret-forte-diferente-do-nextauth

# Access token do platform admin (JWT, jose/HS256) — deliberadamente separado do AUTH_TOKEN_SECRET,
# nunca pode ser confundido com nem forjado a partir de um token de tenant (ver
# docs/adr/0003-platform-admin-identidade-separada.md)
PLATFORM_TOKEN_SECRET=troque-por-outro-secret-forte-diferente-dos-demais

# Primeiro platform admin (usado por `npm run db:seed` — ver prisma/seed.ts e ADR-0003, seção
# Atualização). Só é lido se ainda não existir nenhum platform admin no banco; em produção, defina
# antes de rodar o seed pela primeira vez.
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# MapLibre (URL do style de tiles — ex.: provedor gratuito/self-hosted)
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
