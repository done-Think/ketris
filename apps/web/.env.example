# App
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco de dados (Postgres local — ver docker-compose.yml na raiz: `docker compose up -d`)
DATABASE_URL="postgresql://ketris:ketris@localhost:55532/ketris?schema=public"

# API/BFF: vazio/relativo aponta para o próprio Next.js (Route Handlers em src/app/api, ver ADR-0001,
# docs/adr/0001-bff-banco-orm.md). Só use uma URL absoluta se o BFF for extraído para um serviço separado.
NEXT_PUBLIC_API_URL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=troque-por-um-secret-forte

# Access token (JWT, jose/HS256) assinado pelo BFF — deliberadamente separado do NEXTAUTH_SECRET
# (ver docs/adr/0002-arquitetura-interna-bff.md)
AUTH_TOKEN_SECRET=troque-por-outro-secret-forte-diferente-do-nextauth

# Rate limit fora da Vercel: cabeçalho que o proxy da frente do app sobrescreve com o IP do cliente
# (ex.: CloudFront-Viewer-Address). Vazio = contador único para todos (só desenvolvimento).
TRUSTED_CLIENT_IP_HEADER=

# Cotas compartilhadas em PostgreSQL; falha do contador retorna 503 (fail closed).
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
MARKETPLACE_INQUIRY_RATE_LIMIT_MAX=5
MARKETPLACE_INQUIRY_RATE_LIMIT_WINDOW_MS=600000
# Cota adicional por imóvel/e-mail normalizado: transacional com a criação da proposta.
MARKETPLACE_CONTACT_INQUIRY_LIMIT=3
MARKETPLACE_CONTACT_INQUIRY_WINDOW_MS=86400000

# Access token do platform admin (JWT, jose/HS256) — deliberadamente separado do AUTH_TOKEN_SECRET,
# nunca pode ser confundido com nem forjado a partir de um token de tenant (ver
# docs/adr/0003-platform-admin-identidade-separada.md)
PLATFORM_TOKEN_SECRET=troque-por-outro-secret-forte-diferente-dos-demais

# Token de prova de código validado (JWT, jose/HS256) — emitido por POST /api/auth/password-reset-codes/verify
# e exigido por POST /api/auth/reset-password; deliberadamente separado dos demais secrets.
PASSWORD_RESET_TOKEN_SECRET=troque-por-outro-secret-forte-diferente-dos-demais

# Chave base64 de 32 bytes para proteger CPFs dos contratos; use a mesma chave no app e no seed.
# Gere com: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
# Armazene como segredo; não troque sem um procedimento de rotação e backup.
CONTRACTS_DATA_ENCRYPTION_KEY=
# Primeiro platform admin (usado por `npm run db:seed` — ver prisma/seed.ts e ADR-0003, seção
# Atualização). Só é lido se ainda não existir nenhum platform admin no banco; em produção, defina
# antes de rodar o seed pela primeira vez.
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Sentry — o mesmo DSN atende os três runtimes (browser, Node.js e Edge).
# NEXT_PUBLIC_* vai para o bundle do browser; SENTRY_DSN fica só no servidor.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=donethink-ct
SENTRY_PROJECT=ketris
# Secret de build, só para upload de source maps (não é necessário em desenvolvimento).
SENTRY_AUTH_TOKEN=
# Token de leitura (escopo event:read) para a página Sistema do super admin listar os erros
# recentes. Sem ele, a página mostra "Sentry não configurado". SENTRY_API_URL só é necessário
# fora da região padrão (ex.: https://de.sentry.io).
SENTRY_API_TOKEN=
SENTRY_API_URL=

# MapLibre (URL do style de tiles — ex.: provedor gratuito/self-hosted)
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Geocoding no servidor: endpoint /search compatível com Nominatim. Vazio = desativado.
# Preenche coordenadas no cadastro/edição e resolve imóveis antigos na página pública.
# Para testes, pode usar https://nominatim.openstreetmap.org/search após aceitar a política:
# https://operations.osmfoundation.org/policies/nominatim/
# Máximo global de 1 consulta/s, cache, atribuição OSM e sem autocomplete.
# Para maior volume, configure instância própria ou provedor contratado compatível.
GEOCODING_SEARCH_URL=
GEOCODING_USER_AGENT="Ketris/1.0 (+https://github.com/done-Think/ketris)"

# S3 (uploads privados, incluindo documentos de contratos). Credenciais do IAM user dedicado
# provisionado em infra/terraform/ (ver infra/terraform/README.md). Nunca exponha como NEXT_PUBLIC_*:
# o backend autoriza o upload e emite URLs temporárias para o navegador transferir o arquivo.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Credenciais temporárias também exigem AWS_SESSION_TOKEN. Alternativamente, use
# AWS_PROFILE local ou role do workload em produção (cadeia padrão do SDK).
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# SES (códigos de cadastro, recuperação de senha e troca de e-mail). Usa as credenciais AWS acima.
# A policy app_storage do Terraform cobre somente S3; confirme também as permissões de envio SES
# e o remetente/domínio verificado. SES_FROM_EMAIL não é um output do Terraform.
SES_FROM_EMAIL=
