// Schema Prisma da Ketris — fonte de verdade do modelo de dados.
// Entidades derivadas de specs/001-mvp-loop-imovel-pagamento/data-model.md, com Tenant/User/Endereco/Midia
// adicionados como suporte necessário (auth, multi-tenancy, mídia de imóvel). Ver ADR-0001
// (docs/adr/0001-bff-banco-orm.md) para o racional de PostgreSQL + Prisma + multi-tenancy por coluna.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenant & Usuário
// ---------------------------------------------------------------------------

model Tenant {
  id            String   @id @default(cuid())
  nome          String
  slug          String   @unique
  // White-label: cores do tema sobrescrevem primary/secondary do MUI em runtime (docs/stack.md).
  corPrimaria   String?
  corSecundaria String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usuarios      Usuario[]
  imoveis       Imovel[]
  oportunidades Oportunidade[]
  leads         Lead[]
  contratos     Contrato[]
  cobrancas     Cobranca[]
  contatos      Contato[]
  eventosAgenda EventoAgenda[]
  perfilPublico PerfilPublicoImobiliaria?

  @@map("tenants")
}

enum PapelUsuario {
  ADMIN
  OWNER
  AGENT
  RENTER
}

model Usuario {
  id                String       @id @default(cuid())
  tenantId          String
  nome              String
  email             String       @unique
  senhaHash         String
  avatarUrl         String?
  papel             PapelUsuario @default(AGENT)
  ativo             Boolean      @default(true)
  vinculoAprovadoEm DateTime?    @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant                   Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imoveisResponsavel       Imovel[]                           @relation("ImovelResponsavel")
  refreshTokens            RefreshToken[]
  eventosAgendaResponsavel EventoAgenda[]                     @relation("EventoAgendaResponsavel")
  eventosAgendaCriados     EventoAgenda[]                     @relation("EventoAgendaCriadoPor")
  leadsResponsavel         Lead[]                             @relation("LeadResponsavel")
  perfilPublico            PerfilPublicoCorretor?
  destaquesRecebidos       PerfilPublicoImobiliariaDestaque[]

  @@index([tenantId])
  @@map("usuarios")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  tenantId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Platform Admin — identidade separada de Tenant/Usuario, ver ADR-0003
// (docs/adr/0003-platform-admin-identidade-separada.md). Deliberadamente sem tenantId em nenhum
// model desta seção: é o único papel que opera fora do boundary multi-tenant.
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens PlatformAdminRefreshToken[]

  @@map("platform_admins")
}

model PlatformAdminRefreshToken {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  platformAdminId String
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@map("platform_admin_refresh_tokens")
}

// ---------------------------------------------------------------------------
// Imóvel (módulo `properties`)
// ---------------------------------------------------------------------------

enum FinalidadeImovel {
  ALUGUEL
  VENDA
}

enum StatusImovel {
  DRAFT     @map("RASCUNHO")
  PUBLISHED @map("PUBLICADO")
  RENTED    @map("ALUGADO")
  SOLD      @map("VENDIDO")
  INACTIVE  @map("INATIVO")

  @@map("StatusImovel")
}

model Imovel {
  id            String           @id @default(cuid())
  tenantId      String
  responsavelId String
  titulo        String
  descricao     String?
  finalidade    FinalidadeImovel
  tipo          String
  quartos       Int?
  banheiros     Int?
  vagas         Int?
  areaM2        Decimal?         @db.Decimal(10, 2)
  valor         Decimal          @db.Decimal(12, 2)
  condominio    Decimal?         @db.Decimal(10, 2)
  iptu          Decimal?         @db.Decimal(10, 2)
  status        StatusImovel     @default(DRAFT)
  publicadoEm   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsavel   Usuario        @relation("ImovelResponsavel", fields: [responsavelId], references: [id])
  endereco      Endereco?
  midias        Midia[]
  oportunidades Oportunidade[]
  contratos     Contrato[]
  eventosAgenda EventoAgenda[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("imoveis")
}

model Endereco {
  id          String   @id @default(cuid())
  imovelId    String   @unique
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  cep         String
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model Midia {
  id        String   @id @default(cuid())
  imovelId  String
  url       String
  tipo      String   @default("foto")
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId])
  @@map("midias")
}

// ---------------------------------------------------------------------------
// Perfil Público (módulo `marketplace`) — página pública de corretor/imobiliária,
// editada pelo próprio usuário/tenant no dashboard. Sem registro = não aparece no
// diretório público (ver PerfilPublicoStatus).
// ---------------------------------------------------------------------------

enum PerfilPublicoStatus {
  DRAFT     @map("RASCUNHO")
  PUBLISHED @map("PUBLICADO")

  @@map("PerfilPublicoStatus")
}

model PerfilPublicoCorretor {
  id              String              @id @default(cuid())
  usuarioId       String              @unique
  displayName     String
  headline        String?
  bio             String?
  creci           String?
  telefone        String?
  regiao          String?
  bairros         String[]            @default([])
  especialidades  String[]            @default([])
  disponibilidade String?
  corPrimaria     String?
  corSecundaria   String?
  corFundo        String?
  avatarUrl       String?
  bannerUrl       String?
  status          PerfilPublicoStatus @default(DRAFT)
  publicadoEm     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("perfis_publicos_corretor")
}

model PerfilPublicoImobiliaria {
  id            String              @id @default(cuid())
  tenantId      String              @unique
  displayName   String
  headline      String?
  resumo        String?
  legalCreci    String?
  sede          String?
  endereco      String?
  telefone      String?
  email         String?
  cobertura     String[]            @default([])
  segmentos     String[]            @default([])
  anosDeMercado Int?
  corFundo      String?
  logoUrl       String?
  bannerUrl     String?
  status        PerfilPublicoStatus @default(DRAFT)
  publicadoEm   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant    Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destaques PerfilPublicoImobiliariaDestaque[]

  @@map("perfis_publicos_imobiliaria")
}

// Equipe em destaque na página pública da imobiliária — vínculo real por usuário
// (antes era texto livre casado por nome, no mock de frontend).
model PerfilPublicoImobiliariaDestaque {
  id        String @id @default(cuid())
  perfilId  String
  usuarioId String
  ordem     Int    @default(0)

  perfil  PerfilPublicoImobiliaria @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  usuario Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([perfilId, usuarioId])
  @@index([usuarioId])
  @@map("perfis_publicos_imobiliaria_destaques")
}

// ---------------------------------------------------------------------------
// Oportunidade / Proposta (módulo `crm`)
// ---------------------------------------------------------------------------

enum GarantiaContratual {
  FIADOR
  CAUCAO
  SEGURO_FIANCA
  NENHUMA
}

enum StatusOportunidade {
  RASCUNHO
  ENVIADA
  EM_NEGOCIACAO
  ACEITA
  RECUSADA
}

model Oportunidade {
  id                  String             @id @default(cuid())
  tenantId            String
  imovelId            String
  interessadoNome     String
  interessadoEmail    String
  interessadoTelefone String?
  valorProposto       Decimal            @db.Decimal(12, 2)
  prazoContratoMeses  Int?
  inicioPretendido    DateTime?
  garantiaContratual  GarantiaContratual @default(NENHUMA)
  condicoesEspeciais  String[]           @default([])
  observacoes         String?
  status              StatusOportunidade @default(RASCUNHO)
  arquivadaEm         DateTime?
  // Vínculo opcional: a oportunidade nasce do marketplace sem conta de usuário (data-model.md),
  // e só é associada a um Contato quando o corretor identifica o interessado na base.
  contatoId           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict (não Cascade): excluir um imóvel nunca pode apagar oportunidades de tabela junto —
  // isso é decidido explicitamente pela camada de aplicação (ver PropertyRepository.hasLinkedRecords).
  imovel     Imovel                  @relation(fields: [imovelId], references: [id], onDelete: Restrict)
  contrato   Contrato?
  contato    Contato?                @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  atividades AtividadeOportunidade[]
  lead       Lead?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, arquivadaEm])
  @@index([imovelId])
  @@index([contatoId])
  @@map("oportunidades")
}

enum EstagioLead {
  NOVO
  EM_CONTATO
  VISITA_MARCADA
  PROPOSTA
}

// Contato bruto, ainda não qualificado com um imóvel específico nem valor proposto — por isso não
// é uma Oportunidade ainda. Vira uma quando o corretor converte (ver ConvertLeadToOpportunityUseCase).
model Lead {
  id             String      @id @default(cuid())
  tenantId       String
  responsavelId  String
  nome           String
  telefone       String
  email          String?
  interesse      String
  orcamento      String
  origem         String
  estagio        EstagioLead @default(NOVO)
  observacoes    String?
  oportunidadeId String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsavel  Usuario       @relation("LeadResponsavel", fields: [responsavelId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, estagio])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Contato / Atividade (módulo `crm`)
// ---------------------------------------------------------------------------

enum TipoContato {
  PROPRIETARIO
  LOCATARIO
  CORRETOR
}

// Agenda de relacionamento do tenant. Independente de `Usuario`: um contato é alguém com quem o
// tenant se relaciona (proprietário, locatário, corretor parceiro), não alguém que loga no sistema.
model Contato {
  id              String      @id @default(cuid())
  tenantId        String
  nome            String
  email           String
  telefone        String?
  tipo            TipoContato @default(LOCATARIO)
  avatarUrl       String?
  observacoes     String?
  ultimaInteracao DateTime?
  arquivadoEm     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  oportunidades Oportunidade[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, tipo])
  @@index([tenantId, arquivadoEm])
  @@map("contatos")
}

enum TipoAtividadeOportunidade {
  NOTA
  MUDANCA_STATUS
  CONTATO_REALIZADO
  PROPOSTA_RESPONDIDA
}

// Timeline da oportunidade. Registro append-only: alimenta o painel de atividades do CRM e serve
// de trilha de auditoria de quem respondeu o quê e quando.
model AtividadeOportunidade {
  id             String                    @id @default(cuid())
  oportunidadeId String
  tipo           TipoAtividadeOportunidade
  descricao      String
  // Autor é opcional porque atividades também nascem de eventos do sistema (ex.: proposta recebida
  // pelo marketplace, sem usuário autenticado por trás).
  autorId        String?
  autorNome      String?
  statusAnterior StatusOportunidade?
  statusNovo     StatusOportunidade?
  createdAt      DateTime                  @default(now())

  oportunidade Oportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)

  @@index([oportunidadeId])
  @@index([oportunidadeId, createdAt])
  @@map("atividades_oportunidade")
}

// ---------------------------------------------------------------------------
// Contrato / Assinatura (módulo `contracts`)
// ---------------------------------------------------------------------------

enum StatusContrato {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ATIVO
}

model Contrato {
  id                   String         @id @default(cuid())
  tenantId             String
  imovelId             String
  oportunidadeOrigemId String         @unique // FR-014: contrato sempre nasce de uma oportunidade aceita
  valor                Decimal        @db.Decimal(12, 2)
  status               StatusContrato @default(RASCUNHO)
  ativadoEm            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict (não Cascade): um contrato nunca pode desaparecer junto com o imóvel excluído.
  imovel             Imovel          @relation(fields: [imovelId], references: [id], onDelete: Restrict)
  oportunidadeOrigem Oportunidade    @relation(fields: [oportunidadeOrigemId], references: [id])
  partes             ParteContrato[]
  cobrancas          Cobranca[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("contratos")
}

enum PapelParteContrato {
  LOCADOR
  LOCATARIO
  FIADOR
}

model ParteContrato {
  id         String             @id @default(cuid())
  contratoId String
  papel      PapelParteContrato
  nome       String
  cpf        String
  email      String
  telefone   String?

  contrato   Contrato    @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  assinatura Assinatura?

  @@index([contratoId])
  @@map("partes_contrato")
}

enum StatusAssinatura {
  PENDENTE
  ASSINADA
}

model Assinatura {
  id              String           @id @default(cuid())
  parteContratoId String           @unique // uma assinatura por parte do contrato
  status          StatusAssinatura @default(PENDENTE)
  assinadaEm      DateTime?

  parteContrato ParteContrato @relation(fields: [parteContratoId], references: [id], onDelete: Cascade)

  @@map("assinaturas")
}

// ---------------------------------------------------------------------------
// Evento de agenda (módulo `agenda`)
// ---------------------------------------------------------------------------

enum StatusEventoAgenda {
  CONFIRMED
  PENDING
  RESCHEDULE
  CANCELLED
}

enum TipoEventoAgenda {
  VISIT
  FOLLOW_UP
  MEETING
  INSPECTION
  SIGNATURE
  OTHER
}

model EventoAgenda {
  id                    String             @id @default(cuid())
  tenantId              String
  responsavelId         String
  criadoPorId           String?
  imovelId              String?
  referenciaImovelLivre String?
  titulo                String
  tipo                  TipoEventoAgenda?
  status                StatusEventoAgenda @default(CONFIRMED)
  inicio                DateTime
  fim                   DateTime
  participanteNome      String
  participanteTelefone  String
  notas                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsavel Usuario  @relation("EventoAgendaResponsavel", fields: [responsavelId], references: [id], onDelete: Cascade)
  criadoPor   Usuario? @relation("EventoAgendaCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  imovel      Imovel?  @relation(fields: [imovelId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, inicio])
  @@index([responsavelId])
  @@index([imovelId])
  @@map("eventos_agenda")
}

// ---------------------------------------------------------------------------
// Cobrança (módulo `financial`)
// ---------------------------------------------------------------------------

enum TipoCobranca {
  A_RECEBER
  A_PAGAR
}

enum StatusCobranca {
  PENDENTE
  PAGA
  ATRASADA
  AGENDADA
  CANCELADA
}

model Cobranca {
  id             String         @id @default(cuid())
  tenantId       String
  contratoId     String
  tipo           TipoCobranca   @default(A_RECEBER)
  valor          Decimal        @db.Decimal(12, 2)
  vencimento     DateTime
  formaPagamento String?
  comprovanteUrl String?
  status         StatusCobranca @default(PENDENTE)
  pagoEm         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([contratoId])
  @@map("cobrancas")
}
