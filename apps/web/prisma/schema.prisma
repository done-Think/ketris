// Schema Prisma da Ketris — fonte de verdade do modelo de dados.
// Entidades derivadas de specs/001-mvp-loop-imovel-pagamento/data-model.md, com Tenant/User/Endereco/Midia
// adicionados como suporte necessário (auth, multi-tenancy, mídia de imóvel). Ver ADR-0001
// (docs/adr/0001-bff-banco-orm.md) para o racional de PostgreSQL + Prisma + multi-tenancy por coluna.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenant & Usuário
// ---------------------------------------------------------------------------

model Tenant {
  id            String            @id @default(cuid())
  nome          String
  slug          String            @unique
  // White-label: cores do tema sobrescrevem primary/secondary do MUI em runtime (docs/stack.md).
  corPrimaria   String?
  corSecundaria String?
  // Tipo de conta define o plano cobrado pela plataforma (ver PlatformPlan); a situação define se
  // a conta entra no MRR. Não há gateway de pagamento: os dois são mantidos pelo super admin.
  accountType   TenantAccountType @default(AGENCY)
  status        TenantStatus      @default(ACTIVE)
  canceledAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  usuarios           Usuario[]
  imoveis            Imovel[]
  oportunidades      Oportunidade[]
  leads              Lead[]
  contratos          Contrato[]
  cobrancas          Cobranca[]
  contatos           Contato[]
  eventosAgenda      EventoAgenda[]
  chamadosManutencao ChamadoManutencao[]
  perfilPublico      PerfilPublicoImobiliaria?
  statusChanges      TenantStatusChange[]

  @@map("tenants")
}

enum TenantAccountType {
  INDIVIDUAL
  BROKER
  AGENCY
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

// Histórico das mudanças de situação do tenant, base do churn mensal. É só de inclusão: reativar um
// tenant cancelado registra uma nova mudança em vez de reescrever o passado, então o churn de um mês
// já fechado não muda depois. Tenant.canceledAt fica apenas para exibição do cancelamento atual.
model TenantStatusChange {
  id          String       @id @default(cuid())
  tenantId    String
  fromStatus  TenantStatus
  toStatus    TenantStatus
  changedAt   DateTime     @default(now())
  changedById String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changedBy PlatformAdmin? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([tenantId, changedAt])
  @@index([changedById])
  @@map("tenant_status_changes")
}

// Tabela de preços da plataforma, uma linha por tipo de conta, editada pelo super admin.
// includedUnits conta imóveis (pessoa física e corretor) ou corretores ativos (imobiliária);
// cada unidade acima disso custa extraUnitPrice.
model PlatformPlan {
  accountType    TenantAccountType @id
  monthlyPrice   Decimal           @db.Decimal(12, 2)
  includedUnits  Int
  extraUnitPrice Decimal           @db.Decimal(12, 2)
  updatedAt      DateTime          @updatedAt

  @@map("platform_plans")
}

enum PapelUsuario {
  OWNER
  AGENT
  RENTER
  PROPERTY_OWNER
}

model Usuario {
  id                String       @id @default(cuid())
  tenantId          String
  nome              String
  email             String       @unique
  senhaHash         String
  avatarUrl         String?
  papel             PapelUsuario @default(AGENT)
  ativo             Boolean      @default(true)
  vinculoAprovadoEm DateTime?    @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant                   Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imoveisResponsavel       Imovel[]                           @relation("ImovelResponsavel")
  imoveisProprietario      Imovel[]                           @relation("ImovelProprietario")
  partesContrato          ParteContrato[]
  chamadosResponsavel     ChamadoManutencao[]                 @relation("ChamadoResponsavel")
  refreshTokens            RefreshToken[]
  codigosRecuperacaoSenha  PasswordResetCode[]
  eventosAgendaResponsavel EventoAgenda[]                     @relation("EventoAgendaResponsavel")
  eventosAgendaCriados     EventoAgenda[]                     @relation("EventoAgendaCriadoPor")
  eventosAgendaDono        EventoAgenda[]                     @relation("EventoAgendaDono")
  participacoesAgenda      EventoAgendaParticipante[]
  assinaturasRegistradas   Assinatura[]                       @relation("AssinaturaRegistradaPor")
  contratosAtivados        Contrato[]                         @relation("ContratoAtivadoPor")
  leadsResponsavel         Lead[]                             @relation("LeadResponsavel")
  perfilPublico            PerfilPublicoCorretor?
  destaquesRecebidos       PerfilPublicoImobiliariaDestaque[]

  @@index([tenantId])
  @@map("usuarios")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  tenantId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

model PasswordResetCode {
  id         String    @id @default(cuid())
  codeHash   String
  userId     String
  tenantId   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("password_reset_codes")
}

// ---------------------------------------------------------------------------
// Platform Admin — identidade separada de Tenant/Usuario, ver ADR-0003
// (docs/adr/0003-platform-admin-identidade-separada.md). Deliberadamente sem tenantId em nenhum
// model desta seção: é o único papel que opera fora do boundary multi-tenant.
// ---------------------------------------------------------------------------

enum PlatformAdminRole {
  ADMIN
  ADMIN_AGENT
  AGENT
}

model PlatformAdmin {
  id        String            @id @default(cuid())
  nome      String
  email     String            @unique
  senhaHash String
  role      PlatformAdminRole @default(ADMIN)
  ativo     Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  refreshTokens       PlatformAdminRefreshToken[]
  tenantStatusChanges TenantStatusChange[]

  @@map("platform_admins")
}

model PlatformAdminRefreshToken {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  platformAdminId String
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@map("platform_admin_refresh_tokens")
}

// ---------------------------------------------------------------------------
// Imóvel (módulo `properties`)
// ---------------------------------------------------------------------------

enum FinalidadeImovel {
  ALUGUEL
  VENDA
  AMBOS
}

enum StatusImovel {
  DRAFT     @map("RASCUNHO")
  PUBLISHED @map("PUBLICADO")
  RENTED    @map("ALUGADO")
  SOLD      @map("VENDIDO")
  INACTIVE  @map("INATIVO")

  @@map("StatusImovel")
}

model Imovel {
  id            String           @id @default(cuid())
  tenantId      String
  responsavelId String
  proprietarioId String?
  titulo        String
  descricao     String?
  finalidade    FinalidadeImovel
  tipo          String
  quartos       Int?
  banheiros     Int?
  vagas         Int?
  areaM2        Decimal?         @db.Decimal(10, 2)
  valor         Decimal          @db.Decimal(12, 2)
  valorAluguel  Decimal?         @db.Decimal(12, 2)
  condominio    Decimal?         @db.Decimal(10, 2)
  iptu          Decimal?         @db.Decimal(10, 2)
  status        StatusImovel     @default(DRAFT)
  publicadoEm   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsavel        Usuario             @relation("ImovelResponsavel", fields: [responsavelId], references: [id])
  proprietario       Usuario?            @relation("ImovelProprietario", fields: [proprietarioId], references: [id], onDelete: SetNull)
  endereco           Endereco?
  midias             Midia[]
  oportunidades      Oportunidade[]
  contratos          Contrato[]
  eventosAgenda      EventoAgenda[]
  chamadosManutencao ChamadoManutencao[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, proprietarioId])
  @@map("imoveis")
}

model Endereco {
  id          String   @id @default(cuid())
  imovelId    String   @unique
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  cep         String
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model Midia {
  id        String   @id @default(cuid())
  imovelId  String
  url       String
  tipo      String   @default("foto")
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId])
  @@map("midias")
}

// ---------------------------------------------------------------------------
// Perfil Público (módulo `marketplace`) — página pública de corretor/imobiliária,
// editada pelo próprio usuário/tenant no dashboard. Sem registro = não aparece no
// diretório público (ver PerfilPublicoStatus).
// ---------------------------------------------------------------------------

enum PerfilPublicoStatus {
  DRAFT     @map("RASCUNHO")
  PUBLISHED @map("PUBLICADO")

  @@map("PerfilPublicoStatus")
}

model PerfilPublicoCorretor {
  id              String              @id @default(cuid())
  usuarioId       String              @unique
  displayName     String
  headline        String?
  bio             String?
  creci           String?
  telefone        String?
  regiao          String?
  bairros         String[]            @default([])
  especialidades  String[]            @default([])
  disponibilidade String?
  corPrimaria     String?
  corSecundaria   String?
  corFundo        String?
  avatarUrl       String?
  bannerUrl       String?
  status          PerfilPublicoStatus @default(DRAFT)
  publicadoEm     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("perfis_publicos_corretor")
}

model PerfilPublicoImobiliaria {
  id            String              @id @default(cuid())
  tenantId      String              @unique
  displayName   String
  headline      String?
  resumo        String?
  legalCreci    String?
  sede          String?
  endereco      String?
  telefone      String?
  email         String?
  cobertura     String[]            @default([])
  segmentos     String[]            @default([])
  anosDeMercado Int?
  corFundo      String?
  logoUrl       String?
  bannerUrl     String?
  status        PerfilPublicoStatus @default(DRAFT)
  publicadoEm   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant    Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destaques PerfilPublicoImobiliariaDestaque[]

  @@map("perfis_publicos_imobiliaria")
}

// Equipe em destaque na página pública da imobiliária — vínculo real por usuário
// (antes era texto livre casado por nome, no mock de frontend).
model PerfilPublicoImobiliariaDestaque {
  id        String @id @default(cuid())
  perfilId  String
  usuarioId String
  ordem     Int    @default(0)

  perfil  PerfilPublicoImobiliaria @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  usuario Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([perfilId, usuarioId])
  @@index([usuarioId])
  @@map("perfis_publicos_imobiliaria_destaques")
}

// ---------------------------------------------------------------------------
// Oportunidade / Proposta (módulo `crm`)
// ---------------------------------------------------------------------------

enum GarantiaContratual {
  FIADOR
  CAUCAO
  SEGURO_FIANCA
  NENHUMA
}

enum StatusOportunidade {
  RASCUNHO
  ENVIADA
  EM_NEGOCIACAO
  ACEITA
  RECUSADA
}

model Oportunidade {
  id                  String             @id @default(cuid())
  tenantId            String
  imovelId            String
  interessadoNome     String
  interessadoEmail    String
  interessadoTelefone String?
  valorProposto       Decimal            @db.Decimal(12, 2)
  prazoContratoMeses  Int?
  inicioPretendido    DateTime?
  garantiaContratual  GarantiaContratual @default(NENHUMA)
  condicoesEspeciais  String[]           @default([])
  observacoes         String?
  status              StatusOportunidade @default(RASCUNHO)
  arquivadaEm         DateTime?
  // Vínculo opcional: a oportunidade nasce do marketplace sem conta de usuário (data-model.md),
  // e só é associada a um Contato quando o corretor identifica o interessado na base.
  contatoId           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict (não Cascade): excluir um imóvel nunca pode apagar oportunidades de tabela junto —
  // isso é decidido explicitamente pela camada de aplicação (ver PropertyRepository.hasLinkedRecords).
  imovel     Imovel                  @relation(fields: [imovelId], references: [id], onDelete: Restrict)
  contrato   Contrato?
  contato    Contato?                @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  atividades AtividadeOportunidade[]
  lead       Lead?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, arquivadaEm])
  @@index([imovelId])
  @@index([contatoId])
  @@map("oportunidades")
}

enum EstagioLead {
  NOVO
  EM_CONTATO
  VISITA_MARCADA
  PROPOSTA
}

// Contato bruto, ainda não qualificado com um imóvel específico nem valor proposto — por isso não
// é uma Oportunidade ainda. Vira uma quando o corretor converte (ver ConvertLeadToOpportunityUseCase).
model Lead {
  id             String      @id @default(cuid())
  tenantId       String
  responsavelId  String
  nome           String
  telefone       String
  email          String?
  interesse      String
  orcamento      String
  origem         String
  estagio        EstagioLead @default(NOVO)
  observacoes    String?
  oportunidadeId String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsavel  Usuario       @relation("LeadResponsavel", fields: [responsavelId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, estagio])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Contato / Atividade (módulo `crm`)
// ---------------------------------------------------------------------------

enum TipoContato {
  PROPRIETARIO
  LOCATARIO
  CORRETOR
}

// Agenda de relacionamento do tenant. Independente de `Usuario`: um contato é alguém com quem o
// tenant se relaciona (proprietário, locatário, corretor parceiro), não alguém que loga no sistema.
model Contato {
  id              String      @id @default(cuid())
  tenantId        String
  nome            String
  email           String
  telefone        String?
  tipo            TipoContato @default(LOCATARIO)
  avatarUrl       String?
  observacoes     String?
  ultimaInteracao DateTime?
  arquivadoEm     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  oportunidades Oportunidade[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, tipo])
  @@index([tenantId, arquivadoEm])
  @@map("contatos")
}

enum TipoAtividadeOportunidade {
  NOTA
  MUDANCA_STATUS
  CONTATO_REALIZADO
  PROPOSTA_RESPONDIDA
}

// Timeline da oportunidade. Registro append-only: alimenta o painel de atividades do CRM e serve
// de trilha de auditoria de quem respondeu o quê e quando.
model AtividadeOportunidade {
  id             String                    @id @default(cuid())
  oportunidadeId String
  tipo           TipoAtividadeOportunidade
  descricao      String
  // Autor é opcional porque atividades também nascem de eventos do sistema (ex.: proposta recebida
  // pelo marketplace, sem usuário autenticado por trás).
  autorId        String?
  autorNome      String?
  statusAnterior StatusOportunidade?
  statusNovo     StatusOportunidade?
  createdAt      DateTime                  @default(now())

  oportunidade Oportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)

  @@index([oportunidadeId])
  @@index([oportunidadeId, createdAt])
  @@map("atividades_oportunidade")
}

// ---------------------------------------------------------------------------
// Contrato / Assinatura (módulo `contracts`)
// ---------------------------------------------------------------------------

enum StatusContrato {
  RASCUNHO
  EM_REVISAO
  AGUARDANDO_ASSINATURA
  ASSINADO
  ATIVO
  ENCERRADO
  CANCELADO
}

enum TipoContrato {
  RESIDENCIAL
  COMERCIAL
  TEMPORADA
}

enum IndiceReajuste {
  IPCA
  IGPM
  INPC
}

enum TipoGarantia {
  FIADOR
  CAUCAO
  SEGURO_FIANCA
  TITULO_CAPITALIZACAO
}

model Contrato {
  id                   String         @id @default(cuid())
  tenantId             String
  imovelId             String
  oportunidadeOrigemId String         @unique // FR-014: contrato sempre nasce de uma oportunidade aceita
  codigo               String         @unique
  tipo                 TipoContrato   @default(RESIDENCIAL)
  valor                Decimal        @db.Decimal(12, 2)
  diaVencimento        Int
  dataInicio           DateTime
  dataFim              DateTime
  indiceReajuste       IndiceReajuste
  tipoGarantia         TipoGarantia
  observacoes          String?
  status               StatusContrato @default(RASCUNHO)
  ativadoEm            DateTime?
  // Quem registrou a última assinatura, que ativou o contrato.
  ativadoPorId         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ativadoPor         Usuario?            @relation("ContratoAtivadoPor", fields: [ativadoPorId], references: [id], onDelete: SetNull)
  // Restrict (não Cascade): um contrato nunca pode desaparecer junto com o imóvel excluído.
  imovel             Imovel              @relation(fields: [imovelId], references: [id], onDelete: Restrict)
  oportunidadeOrigem Oportunidade        @relation(fields: [oportunidadeOrigemId], references: [id])
  partes             ParteContrato[]
  cobrancas          Cobranca[]
  documentos         DocumentoContrato[]
  chamadosManutencao  ChamadoManutencao[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("contratos")
}

model DocumentoContrato {
  id         String   @id @default(cuid())
  contratoId String
  nome       String
  url        String?
  createdAt  DateTime @default(now())

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId])
  @@map("documentos_contrato")
}

enum PapelParteContrato {
  LOCADOR
  LOCATARIO
  FIADOR
}

model ParteContrato {
  id         String             @id @default(cuid())
  contratoId String
  papel      PapelParteContrato
  nome       String
  cpf        String
  email      String
  telefone   String?
  usuarioId  String?

  contrato   Contrato    @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  assinatura Assinatura?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([contratoId])
  @@index([usuarioId])
  @@map("partes_contrato")
}

enum StatusAssinatura {
  PENDENTE
  ASSINADA
}

model Assinatura {
  id              String           @id @default(cuid())
  parteContratoId String           @unique // uma assinatura por parte do contrato
  status          StatusAssinatura @default(PENDENTE)
  assinadaEm      DateTime?
  // Usuário da imobiliária que registrou a assinatura no sistema.
  assinadaPorId   String?

  parteContrato ParteContrato @relation(fields: [parteContratoId], references: [id], onDelete: Cascade)
  assinadaPor   Usuario?      @relation("AssinaturaRegistradaPor", fields: [assinadaPorId], references: [id], onDelete: SetNull)

  @@map("assinaturas")
}

// ---------------------------------------------------------------------------
// Evento de agenda (módulo `agenda`)
// ---------------------------------------------------------------------------

enum StatusEventoAgenda {
  CONFIRMED
  PENDING
  RESCHEDULE
  CANCELLED
}

enum TipoEventoAgenda {
  VISIT
  FOLLOW_UP
  MEETING
  INSPECTION
  SIGNATURE
  OTHER
}

// Papéis de pessoa no evento (não presumir que coincidam):
// - responsavelId: quem responde pelo evento na imobiliária (staff do tenant do evento).
// - criadoPorId: auditoria de quem criou o registro; não concede acesso.
// - donoUsuarioId: dono explícito do evento para fins de acesso de leitura (pode ser um
//   RENTER do tenant compartilhado de locatários ou staff do tenant do evento).
// - participantes (EventoAgendaParticipante): usuários com acesso de leitura ao evento.
// participanteNome/participanteTelefone são apenas dados de exibição para a equipe e não
// identificam nem autorizam nenhum usuário.
enum DestinoEventoAgenda {
  LEGACY_TEAM
  ALL_AGENTS
  ASSIGNED_AGENT
}

model EventoAgenda {
  id                    String             @id @default(cuid())
  tenantId              String
  responsavelId         String
  criadoPorId           String?
  donoUsuarioId         String?
  imovelId              String?
  referenciaImovelLivre String?
  titulo                String
  tipo                  TipoEventoAgenda?
  destino               DestinoEventoAgenda @default(LEGACY_TEAM)
  interno               Boolean            @default(false)
  status                StatusEventoAgenda @default(CONFIRMED)
  inicio                DateTime
  fim                   DateTime
  participanteNome      String
  participanteTelefone  String
  notas                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsavel Usuario  @relation("EventoAgendaResponsavel", fields: [responsavelId], references: [id], onDelete: Cascade)
  criadoPor   Usuario? @relation("EventoAgendaCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  donoUsuario Usuario? @relation("EventoAgendaDono", fields: [donoUsuarioId], references: [id], onDelete: SetNull)
  imovel      Imovel?  @relation(fields: [imovelId], references: [id], onDelete: SetNull)

  participantes EventoAgendaParticipante[]

  @@index([tenantId])
  @@index([tenantId, inicio])
  @@index([responsavelId])
  @@index([donoUsuarioId])
  @@index([imovelId])
  @@map("eventos_agenda")
}

model EventoAgendaParticipante {
  id        String   @id @default(cuid())
  eventoId  String
  usuarioId String
  createdAt DateTime @default(now())

  evento  EventoAgenda @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([eventoId, usuarioId])
  @@index([usuarioId])
  @@map("eventos_agenda_participantes")
}

// ---------------------------------------------------------------------------
// Cobrança (módulo `financial`)
// ---------------------------------------------------------------------------

enum TipoCobranca {
  A_RECEBER
  A_PAGAR
}

enum StatusCobranca {
  PENDENTE
  PAGA
  ATRASADA
  AGENDADA
  CANCELADA
}

model Cobranca {
  id             String         @id @default(cuid())
  tenantId       String
  // Opcional: cobranças avulsas (contas a pagar de fornecedor, sem contrato de locação por trás)
  // não têm contrato — ver módulo `financial`.
  contratoId     String?
  codigo         String         @unique
  // Só usado quando contratoId é nulo (cobrança avulsa) — identifica o fornecedor/finalidade sem
  // depender de contrato/imóvel.
  descricao      String?
  tipo           TipoCobranca   @default(A_RECEBER)
  valor          Decimal        @db.Decimal(12, 2)
  vencimento     DateTime
  formaPagamento String?
  comprovanteUrl String?
  status         StatusCobranca @default(PENDENTE)
  pagoEm         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrato Contrato? @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([contratoId])
  @@map("cobrancas")
}

// ---------------------------------------------------------------------------
// Chamados de manutenção (módulo `maintenance`)
// ---------------------------------------------------------------------------

enum StatusChamadoManutencao {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
  FECHADO
  AGUARDANDO_CONFIRMACAO
  CONTESTADO
  CANCELADO
}

enum PrioridadeChamadoManutencao {
  NORMAL
  ALTA
  URGENTE
}

model ChamadoManutencao {
  id            String                      @id @default(cuid())
  tenantId      String
  imovelId      String
  contratoId    String?
  responsavelId String?
  prestadorNome String?
  prestadorTelefone String?
  prestadorEmail String?
  prestadorObservacoes String?
  concluidoPorId String?
  concluidoPorPapel PapelUsuario?
  excluidoEm DateTime?
  excluidoPorId String?
  categoria     String
  prioridade    PrioridadeChamadoManutencao @default(NORMAL)
  status        StatusChamadoManutencao     @default(ABERTO)
  titulo        String
  descricao     String
  abertoPorId   String
  abertoPorNome String
  resolvidoEm   DateTime?
  atendimentoEm DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  tenant     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imovel     Imovel                       @relation(fields: [imovelId], references: [id], onDelete: Restrict)
  contrato   Contrato?                    @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  responsavel Usuario?                   @relation("ChamadoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  solicitacoesTroca SolicitacaoTrocaPrestador[]
  atividades AtividadeChamadoManutencao[]
  anexos     AnexoChamadoManutencao[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([imovelId])
  @@index([tenantId, excluidoEm])
  @@index([contratoId])
  @@index([responsavelId])
  @@map("chamados_manutencao")
  @@index([tenantId, atendimentoEm])
}

enum TipoAtividadeChamadoManutencao {
  NOTA
  MUDANCA_STATUS
  ANEXO_ADICIONADO
  EDICAO
  RESPONSAVEL_ALTERADO
  PRESTADOR_ALTERADO
  TROCA_SOLICITADA
  TROCA_DECIDIDA
  EXCLUSAO
  RESTAURACAO
}

// Timeline do chamado, mesmo padrão append-only de AtividadeOportunidade — autor opcional/denormalizado
// porque nem toda atividade nasce de uma sessão autenticada (ex.: mudança automática de status).
model AtividadeChamadoManutencao {
  id        String                         @id @default(cuid())
  chamadoId String
  tipo      TipoAtividadeChamadoManutencao
  mensagem  String
  autorId   String?
  autorNome String?
  detalhes  Json?
  createdAt DateTime                       @default(now())

  chamado ChamadoManutencao @relation(fields: [chamadoId], references: [id], onDelete: Cascade)

  @@index([chamadoId])
  @@index([chamadoId, createdAt])
  @@map("atividades_chamado_manutencao")
}

enum StatusSolicitacaoTrocaPrestador {
  PENDENTE
  APROVADA
  REJEITADA
}

model SolicitacaoTrocaPrestador {
  id String @id @default(cuid())
  chamadoId String
  justificativa String
  solicitanteId String
  solicitanteNome String
  status StatusSolicitacaoTrocaPrestador @default(PENDENTE)
  decisaoJustificativa String?
  decididoPorId String?
  decididoPorNome String?
  decididoEm DateTime?
  createdAt DateTime @default(now())
  chamado ChamadoManutencao @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  @@index([chamadoId, status])
  @@map("solicitacoes_troca_prestador")
}

model AnexoChamadoManutencao {
  id        String   @id @default(cuid())
  chamadoId String
  nome      String
  url       String
  createdAt DateTime @default(now())

  chamado ChamadoManutencao @relation(fields: [chamadoId], references: [id], onDelete: Cascade)

  @@index([chamadoId])
  @@map("anexos_chamado_manutencao")
}
