    "@mui/material": "6.5.0",
    "@mui/material-nextjs": "7.3.5",
    "@mui/system": "6.5.0",
    "@mui/x-charts": "7.29.1",
    "@mui/x-data-grid": "7.29.13",
    "@mui/x-date-pickers": "7.29.4",
