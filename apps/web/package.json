    "@tanstack/react-query-devtools": "^5.59.16",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.13",
    "jose": "^4.15.9",
    "maplibre-gl": "^4.7.1",
    "next": "16.3.1",
    "next-auth": "4.24.15",
    "next-intl": "^4.13.7",
    "notistack": "3.0.2",
    "pg": "^8.23.0",
    "react": "18.3.1",
